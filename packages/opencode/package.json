{
  "name": "@mcp-savings/opencode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenCode host adapter for mcp-savings: measures real token usage and MCP tool schema weight from inside a running OpenCode session.",
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@mcp-savings/core": "workspace:*",
    "@opentui/solid": "0.4.3"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.17.13",
    "@opencode-ai/sdk": "1.17.13",
    "@opentui/core": "0.4.3",
    "@opentui/keymap": "0.4.3",
    "solid-js": "1.9.12",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3"
  }
}
