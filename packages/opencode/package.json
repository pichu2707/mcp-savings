{
  "name": "@javilazaro/mcp-savings-opencode",
  "version": "0.5.0",
  "type": "module",
  "description": "OpenCode host adapter for mcp-savings: measures real token usage and MCP tool schema weight from inside a running OpenCode session.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "opencode",
    "opencode-plugin",
    "tokens",
    "token-cost",
    "tui"
  ],
  "license": "MIT",
  "author": "Javi Lázaro",
  "homepage": "https://github.com/pichu2707/mcp-savings#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pichu2707/mcp-savings.git",
    "directory": "packages/opencode"
  },
  "bugs": {
    "url": "https://github.com/pichu2707/mcp-savings/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@javilazaro/mcp-savings-core": "workspace:*",
    "@opentui/solid": "0.4.3"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.17.13",
    "@opencode-ai/sdk": "1.17.13",
    "@opentui/core": "0.4.3",
    "@opentui/keymap": "0.4.3",
    "solid-js": "1.9.12",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3"
  }
}
