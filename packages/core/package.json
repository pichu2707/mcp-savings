{
  "name": "@javilazaro/mcp-savings-core",
  "version": "0.2.0",
  "type": "module",
  "description": "Pure domain logic for measuring MCP server token/schema cost in AI coding agents.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tokens",
    "token-cost",
    "llm",
    "ai-agents",
    "cli"
  ],
  "license": "MIT",
  "author": "Javi Lázaro",
  "homepage": "https://github.com/pichu2707/mcp-savings#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pichu2707/mcp-savings.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/pichu2707/mcp-savings/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mcp-savings": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3"
  }
}
